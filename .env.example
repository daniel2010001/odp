# URL de CKAN
# En desarrollo: vacío para usar el proxy de Vite (evita CORS)
# En producción: http://tu-instancia-ckan.com
PUBLIC_CKAN_URL=

# URL pública del frontend (opcional)
PUBLIC_APP_URL=http://localhost:5173

# URL interna de CKAN (SOLO SERVIDOR — inyectada en runtime por compose).
# La usa el proxy server-side de `/auth/login` (SvelteKit → CKAN).
# NO se expone al cliente; no usar el prefijo PUBLIC_ para este valor.
# - Desarrollo local: vacío → usa el proxy de Vite (http://localhost:5000)
# - Desarrollo (compose): http://ckan-dev:5000
# - Producción (compose): http://ckan:5000
CKAN_INTERNAL_URL=
