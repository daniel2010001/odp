                          "id": "qgnep7pmbuZkS0iLauCNo"
                        },
                        {
                          "type": "text",
                          "name": "CodeL2",
                          "content": "  -H \"Content-Type: application/json\" \\",
                          "fontFamily": "monospace",
                          "fontSize": 12,
                          "fontWeight": 400,
                          "color": "#E2E8F0",
                          "fill": [
