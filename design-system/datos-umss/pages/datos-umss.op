                        },
                        {
                          "type": "text",
                          "name": "CodeL3",
                          "content": "  -d '{",
                          "fontFamily": "monospace",
                          "fontSize": 12,
                          "fontWeight": 400,
                          "color": "#E2E8F0",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#E2E8F0"
                            }
                          ],
                          "lineHeight": 1.6,
                          "id": "O9YgngnQi2dAqLQezRlVY"
                        },
                        {
                          "type": "text",
                          "name": "CodeL4",
                          "content": "    \"resource_id\": \"a3f5d8e2-c1b9-7f4e-a8d2-c5b9e1f3a7d6\",",
                          "fontFamily": "monospace",
                          "fontSize": 12,
                          "fontWeight": 400,
