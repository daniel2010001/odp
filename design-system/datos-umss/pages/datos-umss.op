                              "type": "solid",
                              "color": "#A78BFA"
                            }
                          ],
                          "lineHeight": 1.6,
                          "id": "NZ12AbcaJ3f8nEWDZA1z0"
                        },
                        {
                          "type": "text",
                          "name": "CodeL5",
                          "content": "    \"filters\": { \"Anio\": 2024, \"Facultad\": \"Medicina\" },",
                          "fontFamily": "monospace",
                          "fontSize": 12,
                          "fontWeight": 400,
                          "color": "#E2E8F0",
                          "fill": [
