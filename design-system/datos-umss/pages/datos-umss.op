                        },
                        {
                          "type": "text",
                          "name": "CodeL6",
                          "content": "    \"limit\": 5",
                          "fontFamily": "monospace",
                          "fontSize": 12,
                          "fontWeight": 400,
                          "color": "#E2E8F0",
                          "fill": [
