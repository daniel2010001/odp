{
	"origin": "http://localhost:8082",
	"cookies": [
		{
			"name": "odp_prototype",
			"value": "on"
		}
	],
	"width": 1440,
	"outDir": "design/prototipo",
	"removeSelectors": [
		"[data-testid=\"review-strip\"]",
		"button[aria-label=\"Editar colores del tema\"]",
		"div:has(> [data-testid=\"control-panel\"])",
		"[data-testid=\"section-toggles\"]"
	],
	"tabLinks": [
		{
			"selector": "[role=\"tab\"][data-value=\"table\"]",
			"href": "#table"
		},
		{
			"selector": "[role=\"tab\"][data-value]:not([data-value=\"table\"])",
			"href": "#chart-{value}"
		}
	],
	"screens": [
